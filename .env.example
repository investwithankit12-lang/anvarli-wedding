# ============================================================
# ANVARLI EVENT MANAGERS — Environment Variables
# ============================================================
# Copy this file to .env (never commit .env to git)
# Fill in your actual Supabase credentials below.
# ============================================================

# --- Supabase (required for Vercel production) ---
# Get these from: https://supabase.com → Your Project → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# --- Supabase Storage Bucket ---
# Create a bucket named "uploads" in Supabase Storage → make it public
SUPABASE_STORAGE_BUCKET=uploads
